# Copy to .env.seed (gitignored) and fill in. Used only by `pnpm seed`.
# Secret key: Supabase dashboard > Project Settings > API Keys > Secret keys.
# It bypasses RLS. Never put it in .env.local, Vercel, or the app.
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# Password for all three demo logins. Pick something fake; it goes in the README.
DEMO_PASSWORD=
