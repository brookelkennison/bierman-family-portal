# Copy to .env.local and fill in from Supabase: Project Settings > API (or the Connect button).
# Both values are safe for the browser. Never put the secret / service role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
